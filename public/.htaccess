# Serve clean URLs (/politica-de-privacidad) from page.html with a 200,
# without redirecting. Astro builds with build.format = "file".
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
