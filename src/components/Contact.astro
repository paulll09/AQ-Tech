---
import ContactForm from "./ContactForm.tsx";
---

<section id="contacto" class="py-24 px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">

    <div class="contact-grid">

      <!-- Left: info panel -->
      <div class="contact-info reveal-left">

        <span class="avail-badge">
          <span class="avail-dot"></span>
          Disponible
        </span>

        <h2 class="contact-heading">
          ¿Tenés una idea?<br />
          <span class="gradient-text">Hagámosla realidad.</span>
        </h2>

        <p class="contact-desc">
          Completá el formulario y te respondemos en menos de 24 horas.
          Sin compromisos, sin vueltas.
        </p>

        <div class="contact-methods">
          <a
            href="https://wa.me/5493716400743"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-method"
          >
            <div class="method-icon" style="background: rgba(37,211,102,0.1); border-color: rgba(37,211,102,0.2); color: #25D366;">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div>
              <p class="method-label">WhatsApp</p>
              <p class="method-value">Respuesta inmediata</p>
            </div>
          </a>

          <a href="mailto:contacto@aqtech.com.ar" class="contact-method">
            <div class="method-icon" style="background: rgba(34,211,238,0.08); border-color: rgba(34,211,238,0.15); color: #22D3EE;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <p class="method-label">Email</p>
              <p class="method-value">contacto@aqtech.com.ar</p>
            </div>
          </a>

          <a href="https://www.instagram.com/aqtechoficial" target="_blank" rel="noopener noreferrer" class="contact-method">
            <div class="method-icon" style="background: rgba(139,92,246,0.08); border-color: rgba(139,92,246,0.2); color: #a78bfa;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </div>
            <div>
              <p class="method-label">Instagram</p>
              <p class="method-value">@aqtechoficial</p>
            </div>
          </a>
        </div>

      </div>

      <!-- Right: form -->
      <div class="contact-form-wrap reveal-right">
        <ContactForm client:only="react" />
      </div>

    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* Mobile: formulario primero, info después */
  .contact-info     { order: 2; }
  .contact-form-wrap { order: 1; }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1.4fr;
      gap: 5rem;
    }
    /* Desktop: orden visual normal (info izquierda, form derecha) */
    .contact-info      { order: 1; }
    .contact-form-wrap { order: 2; }
  }

  /* ── Info panel ── */
  .avail-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #22C55E;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 999px;
    padding: 0.35rem 0.875rem;
    margin-bottom: 1.5rem;
  }

  .avail-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22C55E;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .contact-heading {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    color: #fff;
    margin-bottom: 1.25rem;
  }

  .contact-desc {
    font-size: 0.95rem;
    color: var(--color-muted);
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgba(255,255,255,0.07);
    border-top-color: rgba(255,255,255,0.11);
    background: var(--color-surface);
    text-decoration: none;
    box-shadow:
      0 1px 0 0 rgba(255,255,255,0.04) inset,
      0 2px 4px  rgba(0,0,0,0.22),
      0 8px 16px rgba(0,0,0,0.26),
      0 18px 36px rgba(0,0,0,0.18);
    transition: transform 0.25s cubic-bezier(0.22,1,0.36,1), box-shadow 0.25s, border-color 0.25s;
  }

  .contact-method:hover {
    transform: translateX(4px) translateY(-2px);
    border-color: rgba(37,99,235,0.3);
    border-top-color: rgba(34,211,238,0.18);
    box-shadow:
      0 1px 0 0 rgba(255,255,255,0.06) inset,
      0 4px 8px  rgba(0,0,0,0.26),
      0 14px 28px rgba(0,0,0,0.30),
      0 28px 48px rgba(0,0,0,0.20),
      0 0 24px   rgba(37,99,235,0.08);
  }

  .method-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .method-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #fff;
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  .method-value {
    font-size: 0.775rem;
    color: var(--color-muted);
  }

  /* ── Form card ── */
  .contact-form-wrap {
    border-radius: 1.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 2.5rem;
    backdrop-filter: blur(16px);
  }

  @media (max-width: 767px) {
    .contact-form-wrap { backdrop-filter: none; }
  }
</style>
