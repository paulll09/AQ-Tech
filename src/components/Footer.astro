---
const year = new Date().getFullYear();

const services = [
  "Sitios Web & Landing Pages",
  "Tiendas Online (E-Commerce)",
  "Sistemas de Gestión a Medida",
  "Integraciones & Automatizaciones",
];

const nav = [
  { label: "Inicio", href: "#" },
  { label: "Servicios", href: "#servicios" },
  { label: "Nosotros", href: "#nosotros" },
  { label: "Proceso", href: "#proceso" },
  { label: "Portafolio", href: "#portfolio" },
  { label: "Contacto", href: "#contacto" },
];
---

<footer class="border-t border-[--color-border]" style="background: rgba(2,11,24,0.95); backdrop-filter: blur(20px);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">

      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="#" class="inline-flex mb-5">
          <img src="/logo.svg" alt="AQ Tech" class="h-10 w-auto object-contain" />
        </a>
        <p class="text-sm text-[--color-muted] leading-relaxed mb-6">
          Estudio de desarrollo de software especializado en soluciones digitales para emprendedores y Pymes.
        </p>
        <!-- Social -->
        <div class="flex items-center gap-3">
          <a
            href="https://www.instagram.com/aqtechoficial"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de AQ Tech"
            class="w-9 h-9 rounded-lg flex items-center justify-center border border-[--color-border] text-[--color-muted] hover:text-white hover:border-blue-500/50 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
            </svg>
          </a>
          <a
            href="https://wa.me/5493716400743"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp de AQ Tech"
            class="w-9 h-9 rounded-lg flex items-center justify-center border border-[--color-border] text-[--color-muted] hover:text-white hover:border-green-500/50 transition-all"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-sm font-bold text-white mb-5 uppercase tracking-wider">Servicios</h4>
        <ul class="space-y-3">
          {services.map((s) => (
            <li>
              <a href="#servicios" class="text-sm text-[--color-muted] hover:text-white transition-colors">
                {s}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-sm font-bold text-white mb-5 uppercase tracking-wider">Navegación</h4>
        <ul class="space-y-3">
          {nav.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[--color-muted] hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="text-sm font-bold text-white mb-5 uppercase tracking-wider">Contacto</h4>
        <ul class="space-y-3">
          <li>
            <a href="mailto:contacto@aqtech.com" class="text-sm text-[--color-muted] hover:text-white transition-colors">
              contacto@aqtech.com
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/5493716400743"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-sm font-medium text-green-400 hover:text-green-300 transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
              WhatsApp directo
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 pt-8 border-t border-[--color-border] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[--color-muted-2]">
        © {year} AQ Tech. Todos los derechos reservados.
      </p>
      <p class="text-xs text-[--color-muted-2]">
        Diseñado y desarrollado por <span class="text-[--color-muted]">AQ Tech</span>
      </p>
    </div>
  </div>
</footer>
