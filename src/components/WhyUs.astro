---
import Icon from "./Icon.astro";

const reasons = [
  {
    icon: "message-circle",
    title: "Hablás con quien construye.",
    desc: "Sin account managers ni cadenas de mails. El mismo que te atiende es el que escribe el código.",
  },
  {
    icon: "tag",
    title: "El precio que acordamos es el que pagás.",
    desc: "Sin extras que aparecen al final, sin costos ocultos, sin estructuras de agencia que encarecen todo.",
  },
  {
    icon: "puzzle",
    title: "Todo a medida, nunca plantillas.",
    desc: "Cada proyecto arranca de cero pensado para tu negocio. Tu solución no es genérica porque tu negocio tampoco lo es.",
  },
  {
    icon: "clock",
    title: "Fechas reales que cumplimos.",
    desc: "Estimamos con honestidad, sin inflar plazos. Si decimos una fecha, la cumplimos.",
  },
  {
    icon: "trending-up",
    title: "Pensado para crecer con vos.",
    desc: "Construimos con la arquitectura correcta desde el día uno para que puedas escalar cuando tu negocio lo pida.",
  },
];
---

<section id="por-que-elegirnos" class="py-24 px-6 lg:px-8">
  <div class="max-w-4xl mx-auto">

    <div class="text-center max-w-2xl mx-auto mb-16 reveal">
      <span class="text-xs font-bold tracking-widest text-[--color-cyan] uppercase mb-4 block">Por qué elegirnos</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black leading-tight mb-4">
        Lo que nos hace<br />
        <span class="gradient-text">diferentes de verdad.</span>
      </h2>
      <p class="text-[--color-muted] text-lg">No promesas vacías. Cosas concretas que importan.</p>
    </div>

    <ul class="wr-list">
      {reasons.map((r, i) => (
        <li
          class="wr-item reveal"
          style={`transition-delay: ${i * 80}ms`}
        >
          <div class="wr-accent" aria-hidden="true"></div>

          <div class="wr-icon">
            <Icon name={r.icon} class="w-5 h-5" />
          </div>

          <div class="wr-body">
            <h3 class="wr-title">{r.title}</h3>
            <p class="wr-desc">{r.desc}</p>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .wr-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    overflow: hidden;
  }

  /* ── Item ── */
  .wr-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: background 0.25s, padding-left 0.3s;
    overflow: hidden;
  }

  .wr-item:last-child { border-bottom: none; }

  .wr-item:hover {
    background: var(--color-surface-2);
    padding-left: 2.5rem;
  }

  /* Barra lateral izquierda que aparece en hover */
  .wr-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--color-blue), var(--color-cyan));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    border-radius: 0 2px 2px 0;
  }

  .wr-item:hover .wr-accent { transform: scaleY(1); }

  /* ── Icon ── */
  .wr-icon {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-cyan);
    background: rgba(34, 211, 238, 0.07);
    border: 1px solid rgba(34, 211, 238, 0.12);
    transition: background 0.25s, box-shadow 0.25s;
  }

  .wr-item:hover .wr-icon {
    background: rgba(34, 211, 238, 0.13);
    box-shadow: 0 0 14px rgba(34, 211, 238, 0.18);
  }

  /* ── Text ── */
  .wr-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .wr-title {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.3;
    transition: color 0.25s;
  }

  .wr-item:hover .wr-title { color: #fff; }

  .wr-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 60ch;
  }

  @media (min-width: 768px) {
    .wr-item { gap: 2rem; padding: 2rem 2.5rem; }
    .wr-item:hover { padding-left: 3rem; }
  }
</style>
