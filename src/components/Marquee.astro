---
const items = [
  "Sin Plantillas",
  "Carga Ultrarrápida",
  "Pagos con Mercado Pago",
  "Atención Personalizada",
  "Diseños Exclusivos",
  "Soporte Técnico Directo",
  "100% A Medida",
  "Trato Directo",
];
---

<div class="relative overflow-hidden py-5" style="background: rgba(10,22,40,0.5); backdrop-filter: blur(12px); border-top: 1px solid rgba(26,52,97,0.4); border-bottom: 1px solid rgba(26,52,97,0.4);">
  <!-- Gradient fades -->
  <div class="absolute left-0 top-0 bottom-0 w-20 z-10" style="background: linear-gradient(to right, rgba(10,22,40,0.8), transparent);"></div>
  <div class="absolute right-0 top-0 bottom-0 w-20 z-10" style="background: linear-gradient(to left, rgba(10,22,40,0.8), transparent);"></div>

  <div class="flex gap-0" aria-hidden="true" style="animation: marquee 32s linear infinite;">
    {[...items, ...items].map((item) => (
      <div class="flex items-center gap-5 shrink-0 px-5">
        <span
          class="text-sm font-semibold tracking-wide whitespace-nowrap gradient-text"
          style="font-family: var(--font-heading);"
        >
          {item}
        </span>
        <span class="w-1 h-1 rounded-full shrink-0" style="background: var(--color-border);"></span>
      </div>
    ))}
  </div>
</div>
