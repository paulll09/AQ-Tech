---
import Layout from "./Layout.astro";
import { Navbar } from "../components/Navbar";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} — AQ Tech`} description={description}>
  <Navbar client:only="react" />
  <main class="pt-32 pb-24 px-6 lg:px-8">
    <article class="legal-prose max-w-3xl mx-auto">
      <span class="text-xs font-bold tracking-widest text-[--color-cyan] uppercase mb-4 block">Legal</span>
      <h1>{title}</h1>
      <p class="legal-updated">Última actualización: {updated}</p>
      <slot />
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal-prose {
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .legal-prose h1 {
    font-size: clamp(1.75rem, 5vw, 2.75rem);
    font-weight: 900;
    line-height: 1.15;
    color: #fff;
    margin-bottom: 0.75rem;
  }

  .legal-prose .legal-updated {
    font-size: 0.875rem;
    color: var(--color-muted-2);
    margin-bottom: 3rem;
  }

  .legal-prose h2 {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    color: #fff;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }

  .legal-prose h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .legal-prose p,
  .legal-prose ul,
  .legal-prose ol {
    margin-bottom: 1rem;
  }

  .legal-prose ul,
  .legal-prose ol {
    padding-left: 1.25rem;
  }

  .legal-prose ul { list-style: disc; }
  .legal-prose ol { list-style: decimal; }

  .legal-prose li {
    margin-bottom: 0.5rem;
  }

  .legal-prose li::marker {
    color: var(--color-cyan);
  }

  .legal-prose strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .legal-prose a {
    color: var(--color-cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-prose a:hover {
    color: var(--color-cyan-light);
  }

  .legal-prose .legal-note {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-cyan);
    background: var(--color-surface);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin: 1.5rem 0;
  }

  .legal-prose .legal-note p:last-child {
    margin-bottom: 0;
  }

  .legal-prose .legal-table-wrap {
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .legal-prose .legal-table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.6;
    overflow-wrap: normal;
  }

  .legal-prose .legal-table th,
  .legal-prose .legal-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .legal-prose .legal-table th {
    color: var(--color-text);
    font-weight: 600;
    background: var(--color-surface);
  }

  .legal-prose .legal-table tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
